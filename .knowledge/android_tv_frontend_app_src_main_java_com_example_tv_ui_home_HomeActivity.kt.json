": "Constructs the content rails, populates items from the view model's state, and applies focus and key handling logic for D-pad interactions."}, {"name": "handleDpadUpWithinRails", "description": "Handles focus remapping when pressing D-pad up within content rails, moving focus to the corresponding item in the row above, or staying boundary at the top row."}], "calls": ["setContentView", "findViewById", "layoutInflater.inflate", "viewModel.loadAll", "viewModel.state.collect", "startActivity", "Log.d", "Log.w", "Toast.makeText", "requestFocus", "load", "addOnPreDrawListener", "setOnKeyListener", "setOnFocusChangeListener", "setOnClickListener", "animate", "elevation"], "search-terms": ["Dpad remap focus content row above", "focus navigation Android TV", "focus boundary behavior first row", "image loading Coil optimize focus", "horizontal content rails Android", "top menu focus Android TV", "focus handling with requestFocus", "focus remapping Kotlin Android", "activity annotated for focus navigation"], "state": 2, "file_id": 38, "knowledge_revision": 1852, "git_revision": "bb2d90130b0a31b1f29736d1b83a3b7468596b70", "revision_history": [{"127": ""}, {"207": "a03e2d67031604b1552aaa993a1f04568c68b54c"}, {"208": "a03e2d67031604b1552aaa993a1f04568c68b54c"}, {"255": "90ccca56685c4cbc540a2affdefd688fed55bf32"}, {"259": "90ccca56685c4cbc540a2affdefd688fed55bf32"}, {"261": "90ccca56685c4cbc540a2affdefd688fed55bf32"}, {"267": "90ccca56685c4cbc540a2affdefd688fed55bf32"}, {"316": "d56ab981389e6dffc7c21f3e310806dbe8593f63"}, {"858": "449b21873cf6d27f8fd6c0796c0394b5c1770116"}, {"1470": "c1d2f1fc16cd782286c2b0990004cbe183cb0f3b"}, {"1473": "c1d2f1fc16cd782286c2b0990004cbe183cb0f3b"}, {"1475": "c1d2f1fc16cd782286c2b0990004cbe183cb0f3b"}, {"1501": "2c977890e30a16d11f5cadee60fcdb824c1d7ae5"}, {"1505": "4f9c7e9941d583b4291849d08d539dbe4018a0bf"}, {"1507": "4f9c7e9941d583b4291849d08d539dbe4018a0bf"}, {"1522": "b57c99f9868f98806f951c20035fcc43b196445d"}, {"1554": "61cf72b99663170574a26