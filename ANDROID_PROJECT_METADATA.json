{
  "projectType": "android-kotlin-gradle",
  "rootDir": "android_tv_frontend",
  "gradleWrapper": "android_tv_frontend/gradlew",
  "settingsFiles": [
    "android_tv_frontend/settings.gradle",
    "android_tv_frontend/settings.gradle.kts"
  ],
  "appModule": {
    "name": ":app",
    "path": "android_tv_frontend/app",
    "buildFile": "android_tv_frontend/app/build.gradle",
    "debugApk": "android_tv_frontend/app/build/outputs/apk/debug/app-debug.apk"
  },
  "modules": [
    { "name": ":app", "path": "android_tv_frontend/app" },
    { "name": ":list", "path": "android_tv_frontend/list" },
    { "name": ":utilities", "path": "android_tv_frontend/utilities" }
  ],
  "buildCommands": [
    "cd android_tv_frontend && ./gradlew assembleDebug",
    "./android_tv_frontend/gradlew -p android_tv_frontend :app:assembleDebug"
  ]
}
