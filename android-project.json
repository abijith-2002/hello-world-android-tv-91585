{
  "type": "android",
  "language": "kotlin",
  "gradle": {
    "rootDir": "android_tv_frontend",
    "wrapper": "android_tv_frontend/gradlew",
    "defaultTask": "assembleDebug",
    "modules": [
      "android_tv_frontend/app",
      "android_tv_frontend/list",
      "android_tv_frontend/utilities"
    ],
    "artifactPaths": {
      "debugApk": "android_tv_frontend/app/build/outputs/apk/debug/app-debug.apk"
    }
  },
  "notes": "Build from repo root with ./gradlew assembleDebug (delegates to android_tv_frontend) or run ./android_tv_frontend/gradlew -p android_tv_frontend assembleDebug."
}
