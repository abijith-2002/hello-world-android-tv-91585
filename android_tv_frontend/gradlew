#!/usr/bin/env sh

# Standard Gradle wrapper launcher
DIR="$(cd "$(dirname "$0")" && pwd)"
WRAPPER_JAR="$DIR/gradle/wrapper/gradle-wrapper.jar"

JAVA_EXE=${JAVA_EXE:-java}
JAVA_OPTS=${JAVA_OPTS:-"-Xmx1024m"}

if [ -f "$WRAPPER_JAR" ]; then
  exec "$JAVA_EXE" $JAVA_OPTS -cp "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
else
  echo "gradle-wrapper.jar not found. Please ensure Gradle wrapper is set up."
  exec gradle "$@"
fi
