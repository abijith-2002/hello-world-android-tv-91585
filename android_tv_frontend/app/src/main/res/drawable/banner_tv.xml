<?xml version="1.0" encoding="utf-8"?>
<!--
  Placeholder TV banner using Nord dark scheme.
  - Base size hint for TV banner aspect (approx 16:5 ~ 1280x360dp). Actual view size is controlled by ImageView.
  - Subtle gradient and centered "MyTV" text via a bitmap foreground.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background surface with rounded corners -->
    <item>
        <shape android:shape="rectangle">
            <!-- Size hint; ImageView can override -->
            <size android:width="1280dp" android:height="360dp" />
            <corners android:radius="16dp" />
            <gradient
                android:startColor="#3B4252"
                android:centerColor="#343B4A"
                android:endColor="#2E3440"
                android:angle="0"/>
        </shape>
    </item>

    <!-- Center icon to provide brand cue (optional) -->
    <item>
        <bitmap
            android:src="@drawable/ic_launcher_foreground"
            android:gravity="center"/>
    </item>
</layer-list>
