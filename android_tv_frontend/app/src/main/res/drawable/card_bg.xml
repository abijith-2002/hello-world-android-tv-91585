<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: brighter stroke -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nord_surface" />
            <corners android:radius="@dimen/card_corner_radius" />
            <stroke android:width="2dp" android:color="@color/nord_focus_stroke" />
        </shape>
    </item>

    <!-- Default enabled (unfocused): subtle 1dp stroke -->
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nord_surface" />
            <corners android:radius="@dimen/card_corner_radius" />
            <stroke android:width="1dp" android:color="@color/nord_unfocused_stroke" />
        </shape>
    </item>

    <!-- Fallback -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nord_surface" />
            <corners android:radius="@dimen/card_corner_radius" />
        </shape>
    </item>
</selector>
