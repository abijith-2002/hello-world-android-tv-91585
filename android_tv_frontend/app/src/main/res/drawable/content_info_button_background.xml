<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: solid #F4F4F4 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/content_info_button_corner_radius" />
            <solid android:color="#F4F4F4" />
        </shape>
    </item>

    <!-- Selected (for completeness on TV) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/content_info_button_corner_radius" />
            <solid android:color="#F4F4F4" />
        </shape>
    </item>

    <!-- Pressed: keep consistent with focused -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/content_info_button_corner_radius" />
            <solid android:color="#F4F4F4" />
        </shape>
    </item>

    <!-- Default: 15% opacity #F4F4F4 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/content_info_button_corner_radius" />
            <solid android:color="#26F4F4F4" />
        </shape>
    </item>
</selector>
