<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: brighter stroke and slight tinted fill -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#263B4252" />
            <stroke android:width="2dp" android:color="@color/nord_focus_stroke" />
        </shape>
    </item>

    <!-- Default enabled -->
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="@color/nord_surface" />
            <stroke android:width="1dp" android:color="@color/nord_unfocused_stroke" />
        </shape>
    </item>

    <!-- Fallback -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="@color/nord_surface" />
        </shape>
    </item>
</selector>
