<?xml version="1.0" encoding="utf-8"?>
<!--
  Selector that swaps background color when focused, maintaining pill shape.
  - Focused: accent background (nord9)
  - Pressed: slightly different via ripple overlay (handled by ripple mask)
  - Default: dark pill (nord0/nord1 blend via existing pill shape)
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/nord9">
    <item android:id="@android:id/mask">
        <!-- Use the same pill as mask for ripple bounds -->
        <shape android:shape="rectangle">
            <corners android:radius="28dp"/>
            <solid android:color="#FFFFFFFF"/>
        </shape>
    </item>

    <item>
        <selector>
            <!-- Pressed keeps focused fill for consistency -->
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="28dp"/>
                    <solid android:color="@color/nord9"/>
                </shape>
            </item>

            <!-- Focused -> accent background -->
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="28dp"/>
                    <solid android:color="@color/nord9"/>
                </shape>
            </item>

            <!-- Default -> dark background -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="28dp"/>
                    <solid android:color="@color/nord1"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
