<?xml version="1.0" encoding="utf-8"?>
<!--
  ColorStateList for action button text.
  Invert on focus/hover/selected (dark text on accent background).
  Default on dark pill uses accent text.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused -->
    <item android:color="@color/nord0" android:state_focused="true"/>
    <!-- Hovered (pointer/mouse) -->
    <item android:color="@color/nord0" android:state_hovered="true"/>
    <!-- Selected (Leanback) -->
    <item android:color="@color/nord0" android:state_selected="true"/>
    <!-- Default/unfocused -->
    <item android:color="@color/nord9"/>
</selector>
