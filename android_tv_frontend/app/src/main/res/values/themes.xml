<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App theme using Material 3 dark with Nord colors -->
    <style name="Theme.TV.NordDark" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Colors -->
        <item name="android:windowBackground">@color/nord_bg</item>


        <item name="colorSurface">@color/nord_surface</item>
        <item name="colorSurfaceVariant">@color/nord_surface</item>

        <item name="colorOnBackground">@color/nord_on_surface</item>
        <item name="colorOnSurface">@color/nord_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/nord_on_surface</item>

        <item name="colorPrimary">@color/nord_grey_400</item>
        <item name="colorOnPrimary">@color/nord_bg</item>
        <item name="colorSecondary">@color/nord_grey_300</item>

        <!-- Typography: Reddit Sans with fallback to system sans -->
        <item name="android:fontFamily">@font/reddit_sans</item>
        <item name="fontFamily">@font/reddit_sans</item>

        <!-- Material components defaults -->
        <item name="materialCardViewStyle">@style/Widget.Card.Nord</item>
        <!-- Ensure default cards don't add compat/content padding -->
        <item name="cardViewStyle">@style/Widget.Card.Nord</item>

        <!-- Rounded shapes across components -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Medium.Rounded</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Medium.Rounded</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Medium.Rounded</item>

        <!-- Ensure full opacity for TV -->
        <item name="android:alpha">1.0</item>
    </style>

    <!-- Card widget styled for TV with subtle elevation and strokes -->
    <style name="Widget.Card.Nord" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/nord_surface</item>
        <!-- Ensure no inner padding so child ImageView can be full-bleed -->
        <item name="contentPadding">0dp</item>
        <!-- Do not add compat padding that can create inner insets -->
        <item name="cardUseCompatPadding">false</item>
        <item name="cardElevation">8dp</item>
        <item name="strokeColor">@color/nord_unfocused_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Medium.Rounded</item>
        <!-- Keep foreground within rounded outline -->
        <item name="android:clipToPadding">false</item>
    </style>

    <!-- ShapeAppearance helper -->
    <style name="ShapeAppearance.Medium.Rounded" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <!-- Use a theme dimension for easy tweaks -->
        <item name="cornerSize">@dimen/card_corner_radius</item>
    </style>

    <!-- Card title text appearance using high-contrast onSurface -->
    <style name="TextAppearance.Card.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">@font/reddit_sans_regular</item>
        <item name="fontFamily">@font/reddit_sans_regular</item>
        <item name="android:textSize">28sp</item>
    </style>
</resources>
