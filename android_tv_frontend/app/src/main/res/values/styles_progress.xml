<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- PUBLIC_INTERFACE -->
    <!-- Widget.Material3Expressive.CircularProgressIndicator.Wavy
         This style alias provides compatibility for the requested expressive/wavy indicator style
         by inheriting from the Material3 CircularProgressIndicator. It keeps Nord theme colors.
         Note: This is a lightweight compatibility shim to satisfy the layout reference without
         changing Gradle dependencies or meta files. -->
    <style name="Widget.Material3Expressive.CircularProgressIndicator.Wavy" parent="Widget.Material3.CircularProgressIndicator">
        <!-- Keep it prominent on Nord dark background -->
        <item name="trackThickness">6dp</item>
        <item name="indicatorSize">56dp</item>
        <!-- Use primary color defined in theme -->
        <item name="indicatorColor">?attr/colorPrimary</item>
        <item name="trackColor">?attr/colorSurfaceVariant</item>
    </style>
</resources>
