<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- PUBLIC_INTERFACE -->
    <!-- Widget.Material3Expressive.CircularProgressIndicator.Wavy
         Compatibility wrapper for expressive circular indicator on TV.
         Note: Avoids unsupported enum attributes to satisfy aapt. -->
    <style name="Widget.Material3Expressive.CircularProgressIndicator.Wavy" parent="Widget.Material3.CircularProgressIndicator">
        <!-- Visual size tweaks for TV -->
        <item name="trackThickness">6dp</item>
        <item name="indicatorSize">56dp</item>

        <!-- Colors: primary = loader blue; track uses surface variant for subtle contrast -->
        <item name="indicatorColor">@color/loader_blue</item>
        <item name="trackColor">?attr/colorSurfaceVariant</item>
    </style>
</resources>
