<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- PUBLIC_INTERFACE -->
    <!-- Style specifically used by the Home screen global loader.
         Uses Material3 CircularProgressIndicator with tuned sizes and colors. -->
    <style name="Widget.TV.CircularProgress.Wavy" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">@color/loader_blue</item>
        <item name="trackColor">@color/nord_surface</item>
        <item name="trackThickness">6dp</item>
        <item name="indicatorSize">@dimen/loader_visual_size</item>
    </style>
</resources>
