<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Nord palette tokens -->
    <!-- Core -->
    <color name="nord_bg">#2E3440</color>          <!-- Background -->
    <color name="nord_surface">#3B4252</color>     <!-- Surface -->
    <color name="nord_on_surface">#ECEFF4</color>  <!-- On-surface text/icons -->

    <!-- Greys (accents/highlight strokes) -->
    <color name="nord_grey_300">#D1D5DB</color>    <!-- Light grey -->
    <color name="nord_grey_400">#9CA3AF</color>    <!-- Medium grey -->
    <color name="nord_grey_500">#6B7280</color>    <!-- Darker grey -->

    <!-- Aliases for clarity -->
    <color name="nord_text">@color/nord_on_surface</color>
    <color name="nord_accent">@color/nord_grey_400</color>
    <color name="nord_secondary">@color/nord_grey_300</color>

    <!-- Focus/press visual states -->
    <color name="nord_focus_stroke">@color/nord_grey_300</color>
    <color name="nord_unfocused_stroke">@color/nord_grey_500</color>
    <color name="nord_ripple_mask">#40D1D5DB</color> <!-- ~25% alpha of light grey -->

    <!-- Shadow with low alpha for subtle TV elevation -->
    <color name="nord_shadow">#1A000000</color>
    <!-- Content Info specific (override Nord on this screen) -->
    <color name="content_text_primary">#FFFFFF</color>
    <color name="content_light_container">#F4F4F4</color>
    <!-- Content Info (Figma #35) specific tokens -->
    <color name="ci_text_primary">#FFFFFFFF</color>
    <color name="ci_icon">#FFFFFFFF</color>

    <!-- Gradient stops for bg_content_info_gradient.xml -->
    <!-- Top transparent, middle ~50% alpha black, bottom ~90% alpha black -->
    <color name="ci_grad_start">#00000000</color>
    <color name="ci_grad_center">#99000000</color>
    <color name="ci_grad_end">#F2000000</color>
</resources>
