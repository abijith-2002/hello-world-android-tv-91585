<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/actionButtonRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minHeight="110dp"
    android:foreground="@drawable/tv_focus_ripple"
    android:focusable="true"
    android:clickable="true">

    <!-- Outer container keeps focus/touch target size; inner visuals reduced via *_xsmall dimens -->
    <LinearLayout
        android:id="@+id/iconContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal|center_vertical"
        android:background="@drawable/pill_button_background"
        android:padding="@dimen/action_button_inner_padding_xsmall">

        <ImageView
            android:id="@+id/buttonIcon"
            android:layout_width="@dimen/action_button_icon_size_xsmall"
            android:layout_height="@dimen/action_button_icon_size_xsmall"
            android:src="@drawable/ic_play"
            android:contentDescription="@string/icon_button_desc" />

        <TextView
            android:id="@+id/buttonLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/action_button_label_margin_top_xsmall"
            android:text="@string/button_play"
            android:textColor="#FFFFFF"
            android:alpha="0.9"
            android:fontFamily="@font/reddit_sans_regular"
            style="@style/TextAppearance.Pill.Small" />
    </LinearLayout>
</FrameLayout>
