<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/actionButtonRoot"
    android:layout_width="142dp"
    android:layout_height="160dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true">

    <!-- Icon Container (Circular Background) -->
    <FrameLayout
        android:id="@+id/iconContainer"
        android:layout_width="104dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="0dp"
        android:background="@drawable/button_icon_background">

        <!-- Icon Image -->
        <ImageView
            android:id="@+id/buttonIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="Button icon" />
    </FrameLayout>

    <!-- Button Label (Hidden by default) -->
    <TextView
        android:id="@+id/buttonLabel"
        android:layout_width="138dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="32dp"
        android:text="Programar"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:alpha="0"
        android:includeFontPadding="false" />
</FrameLayout>
