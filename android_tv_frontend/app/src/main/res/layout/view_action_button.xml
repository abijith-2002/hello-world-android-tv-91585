<?xml version="1.0" encoding="utf-8"?>
<!--
  Reusable action button view for Content Info actions.
  Requirements implemented:
    - Fixed size 52dp x 40dp
    - Corner radius 50dp
    - Focus background: #F4F4F4
    - Unfocused background: #F4F4F4 at 15% opacity
    - Icon-only (no text label)
    - Proper Android TV focus (stateful selector) and pressed ripple
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/actionButtonRoot"
    android:layout_width="52dp"
    android:layout_height="40dp"
    android:focusable="true"
    android:clickable="true"
    android:foreground="@drawable/content_info_button_ripple">

    <!-- Visual container uses background selector that reacts to parent's focused state -->
    <LinearLayout
        android:id="@+id/iconContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:duplicateParentState="true"
        android:gravity="center"
        android:background="@drawable/content_info_button_background"
        android:padding="8dp">

        <ImageView
            android:id="@+id/buttonIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:duplicateParentState="true"
            android:src="@drawable/ic_play"
            app:tint="@color/content_action_button_icon_tint"
            app:tintMode="src_in"
            android:contentDescription="@string/icon_button_desc" />
    </LinearLayout>
</FrameLayout>
