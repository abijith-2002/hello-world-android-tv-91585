<?xml version="1.0" encoding="utf-8"?>
<!--
    Action button for the content info panel.
    Sizing and typography strictly match the provided design spec.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/actionButtonContainer"
    android:layout_width="142dp"
    android:layout_height="156dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@android:color/transparent">

    <!-- Icon Box (background, border, correct dimensions) -->
    <FrameLayout
        android:id="@+id/iconBox"
        android:layout_width="104dp"
        android:layout_height="80dp"
        android:layout_marginStart="19dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/action_button_selector">

        <ImageView
            android:id="@+id/actionIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:contentDescription="@string/action_schedule"
            tools:src="@drawable/ic_launcher_foreground" />
    </FrameLayout>

    <!-- Label: 20sp, bold, #E3E3E3, tight line height, centered -->
    <TextView
        android:id="@+id/actionLabel"
        android:layout_width="138dp"
        android:layout_height="24dp"
        android:layout_marginTop="24dp"
        android:text="Programar"
        android:textColor="#E3E3E3"
        android:textSize="18sp"
        android:fontFamily="@font/reddit_sans_regular"
        android:textStyle="bold"
        android:gravity="center"
        android:includeFontPadding="false"
        tools:ignore="HardcodedText" />

</LinearLayout>
