<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/actionButtonRoot"
    android:layout_width="142dp"
    android:layout_height="160dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="8dp">

    <!-- Icon Container (Circular Background) - 104x80dp oval/circular shape -->
    <FrameLayout
        android:id="@+id/iconContainer"
        android:layout_width="104dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="8dp"
        android:background="@drawable/button_icon_background"
        android:elevation="0dp"
        android:outlineProvider="bounds">

        <!-- Icon Image - 40x40dp centered -->
        <ImageView
            android:id="@+id/buttonIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="Button icon" />
    </FrameLayout>

    <!-- Button Label (Hidden by default, visible when focused) -->
    <TextView
        android:id="@+id/buttonLabel"
        android:layout_width="138dp"
        android:layout_height="24dp"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="24dp"
        android:text="Programar"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:lineHeight="24sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:alpha="0"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:ellipsize="end" />
</FrameLayout>
