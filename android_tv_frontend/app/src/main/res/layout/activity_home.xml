<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#21242A"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Content host (No global/full-screen overlay loader; each rail shows its own inline loader) -->
    <LinearLayout
        android:id="@+id/homeContent"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="24dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Top Menu -->
        <LinearLayout
            android:id="@+id/topMenu"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:descendantFocusability="afterDescendants">

            <TextView
                android:id="@+id/menuHome"
                style="@style/TextAppearance.Pill.Small"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="80dp"
                android:minHeight="36dp"
                android:text="@string/menu_home"
                android:textSize="18sp"
                android:singleLine="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/pill_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:textAlignment="center"
                android:foregroundGravity="center"
                android:foreground="@drawable/tv_focus_ripple"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/menuLogin"
                style="@style/TextAppearance.Pill.Small"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="80dp"
                android:minHeight="36dp"
                android:text="@string/menu_login"
                android:textSize="18sp"
                android:singleLine="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/pill_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:textAlignment="center"
                android:foregroundGravity="center"
                android:foreground="@drawable/tv_focus_ripple"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/menuSetting"
                style="@style/TextAppearance.Pill.Small"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="80dp"
                android:minHeight="36dp"
                android:text="@string/menu_setting"
                android:textSize="18sp"
                android:singleLine="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/pill_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:textAlignment="center"
                android:foregroundGravity="center"
                android:foreground="@drawable/tv_focus_ripple"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/menuMyPlan"
                style="@style/TextAppearance.Pill.Small"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="80dp"
                android:minHeight="36dp"
                android:text="@string/menu_my_plan"
                android:textSize="18sp"
                android:singleLine="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/pill_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:textAlignment="center"
                android:foregroundGravity="center"
                android:foreground="@drawable/tv_focus_ripple"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:includeFontPadding="false"/>
        </LinearLayout>

        <!-- Banner -->
        <ImageView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            android:background="@drawable/banner_tv"
            android:scaleType="centerCrop"
            android:adjustViewBounds="false"
            android:cropToPadding="false"
            android:padding="0dp"
            android:contentDescription="@string/menu_home" />

        <!-- Rails list (per-section inline loaders only; no full-screen/overlay loader) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/rail_title_bottom_padding"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:nextFocusUp="@id/topMenu">

            <LinearLayout
                android:id="@+id/railsContainer"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:paddingTop="4dp"
                android:paddingBottom="32dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Pre-inflated rail placeholders; actual content is populated dynamically.
                     Each rail has its own inline loader defined in view_rail.xml -->
                <include
                    android:id="@+id/trendingRail"
                    layout="@layout/view_rail"
                    android:contentDescription="@string/menu_home" />

                <include
                    android:id="@+id/continueRail"
                    layout="@layout/view_rail"
                    android:contentDescription="@string/menu_home" />

                <include
                    android:id="@+id/dramaRail"
                    layout="@layout/view_rail"
                    android:contentDescription="@string/menu_home" />

            </LinearLayout>

        </ScrollView>
    </LinearLayout>



</FrameLayout>
