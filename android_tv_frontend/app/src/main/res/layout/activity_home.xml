<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nord_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Content host -->
    <LinearLayout
        android:id="@+id/homeContent"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="24dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Top Menu -->
        <LinearLayout
            android:id="@+id/topMenu"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <TextView
                android:id="@+id/menuHome"
                style="@style/TextAppearance.Pill.Small"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="88dp"
                android:minHeight="44dp"
                android:text="@string/menu_home"
                android:textSize="20sp"
                android:lineHeight="22sp"
                android:singleLine="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/pill_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:textAlignment="center"
                android:foregroundGravity="center"
                android:foreground="@drawable/tv_focus_ripple"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="-4dp"
                android:layout_marginBottom="-4dp"/>

            <TextView
                android:id="@+id/menuLogin"
                style="@style/TextAppearance.Card.Title"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="88dp"
                android:minHeight="44dp"
                android:text="@string/menu_login"
                android:textSize="20sp"
                android:lineHeight="22sp"
                android:singleLine="true"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:background="@drawable/pill_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:textAlignment="center"
                android:foregroundGravity="center"
                android:foreground="@drawable/tv_focus_ripple"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="-4dp"
                android:layout_marginBottom="-4dp"/>

            <TextView
                android:id="@+id/menuSetting"
                style="@style/TextAppearance.Card.Title"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="88dp"
                android:minHeight="44dp"
                android:text="@string/menu_setting"
                android:textSize="20sp"
                android:lineHeight="22sp"
                android:singleLine="true"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:background="@drawable/pill_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:textAlignment="center"
                android:foregroundGravity="center"
                android:foreground="@drawable/tv_focus_ripple"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="-4dp"
                android:layout_marginBottom="-4dp"/>

            <TextView
                android:id="@+id/menuMyPlan"
                style="@style/TextAppearance.Card.Title"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="88dp"
                android:minHeight="44dp"
                android:text="@string/menu_my_plan"
                android:textSize="20sp"
                android:lineHeight="22sp"
                android:singleLine="true"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:background="@drawable/pill_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:textAlignment="center"
                android:foregroundGravity="center"
                android:foreground="@drawable/tv_focus_ripple"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="-4dp"
                android:layout_marginBottom="-4dp"/>
        </LinearLayout>

        <!-- Banner -->
        <ImageView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            android:background="@drawable/banner_tv"
            android:scaleType="centerCrop"
            android:adjustViewBounds="false"
            android:cropToPadding="false"
            android:padding="0dp"
            android:contentDescription="@string/app_name" />

        <!-- Rails list -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/railsContainer"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:paddingBottom="32dp"
                android:clipChildren="false"
                android:clipToPadding="false" />

        </ScrollView>
    </LinearLayout>

    <!-- Global loading indicator centered above content -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/circular_progress_indicator"
        style="@style/Widget.TV.CircularProgress.Wavy"
        android:layout_width="@dimen/loader_touch_target"
        android:layout_height="@dimen/loader_touch_target"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminate="true"
        app:indicatorColor="@color/loader_blue_color"
        app:trackColor="@color/nord_surface"
        app:trackCornerRadius="32dp"
        android:background="@color/nord_bg"
        app:indicatorInset="16dp"/>

</FrameLayout>
