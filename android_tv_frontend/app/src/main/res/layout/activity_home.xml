<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#21242A"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Content host -->
    <LinearLayout
        android:id="@+id/homeContent"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="24dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Top Menu -->
        <LinearLayout
            android:id="@+id/topMenu"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <TextView
                android:id="@+id/menuHome"
                style="@style/TextAppearance.Pill.Small"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="88dp"
                android:minHeight="44dp"
                android:text="@string/menu_home"
                android:textSize="20sp"
                android:lineHeight="22sp"
                android:singleLine="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/pill_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:textAlignment="center"
                android:foregroundGravity="center"
                android:foreground="@drawable/tv_focus_ripple"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="-4dp"
                android:layout_marginBottom="-4dp"/>

            <TextView
                android:id="@+id/menuLogin"
                style="@style/TextAppearance.Card.Title"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="88dp"
                android:minHeight="44dp"
                android:text="@string/menu_login"
                android:textSize="20sp"
                android:lineHeight="22sp"
                android:singleLine="true"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:background="@drawable/pill_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:textAlignment="center"
                android:foregroundGravity="center"
                android:foreground="@drawable/tv_focus_ripple"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="-4dp"
                android:layout_marginBottom="-4dp"/>

            <TextView
                android:id="@+id/menuSetting"
                style="@style/TextAppearance.Card.Title"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="88dp"
                android:minHeight="44dp"
                android:text="@string/menu_setting"
                android:textSize="20sp"
                android:lineHeight="22sp"
                android:singleLine="true"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:background="@drawable/pill_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:textAlignment="center"
                android:foregroundGravity="center"
                android:foreground="@drawable/tv_focus_ripple"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="-4dp"
                android:layout_marginBottom="-4dp"/>

            <TextView
                android:id="@+id/menuMyPlan"
                style="@style/TextAppearance.Card.Title"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="88dp"
                android:minHeight="44dp"
                android:text="@string/menu_my_plan"
                android:textSize="20sp"
                android:lineHeight="22sp"
                android:singleLine="true"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:background="@drawable/pill_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:textAlignment="center"
                android:foregroundGravity="center"
                android:foreground="@drawable/tv_focus_ripple"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="-4dp"
                android:layout_marginBottom="-4dp"/>
        </LinearLayout>

        <!-- Banner -->
        <ImageView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            android:background="@drawable/banner_tv"
            android:scaleType="centerCrop"
            android:adjustViewBounds="false"
            android:cropToPadding="false"
            android:padding="0dp"
            android:contentDescription="@string/app_name" />

        <!-- Rails list -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/railsContainer"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:paddingBottom="32dp"
                android:clipChildren="false"
                android:clipToPadding="false" />

        </ScrollView>
    </LinearLayout>

    <!-- Global loading indicator centered above content -->
    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#21242A"
        android:visibility="gone"
        android:focusable="false"
        android:clickable="false">

        <!-- Expressive circular wavy indicator from Material 1.14.0-alpha04 -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/circular_progress_indicator"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorSize="60dp"
            app:indicatorColor="#5C9AEC"
            app:trackColor="#21242A"
            app:trackThickness="6dp"
            app:showAnimationBehavior="inward"
            app:hideAnimationBehavior="outward" />
    </FrameLayout>

</FrameLayout>
