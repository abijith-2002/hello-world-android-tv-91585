<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#21242A"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Content host now wrapped in a single ScrollView so banner scrolls with rails -->
    <ScrollView
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/homeContentInner"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Top Menu -->
            <LinearLayout
                android:id="@+id/topMenu"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/railsContainer">

            <TextView
                android:id="@+id/menuHome"
                style="@style/TextAppearance.Pill.Small"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="80dp"
                android:minHeight="36dp"
                android:text="@string/menu_home"
                android:textSize="18sp"
                android:singleLine="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/pill_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:textAlignment="center"
                android:foregroundGravity="center"
                android:foreground="@drawable/tv_focus_ripple"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/menuLogin"
                style="@style/TextAppearance.Pill.Small"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="80dp"
                android:minHeight="36dp"
                android:text="@string/menu_login"
                android:textSize="18sp"
                android:singleLine="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/pill_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:textAlignment="center"
                android:foregroundGravity="center"
                android:foreground="@drawable/tv_focus_ripple"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/menuSetting"
                style="@style/TextAppearance.Pill.Small"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="80dp"
                android:minHeight="36dp"
                android:text="@string/menu_setting"
                android:textSize="18sp"
                android:singleLine="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/pill_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:textAlignment="center"
                android:foregroundGravity="center"
                android:foreground="@drawable/tv_focus_ripple"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/menuMyPlan"
                style="@style/TextAppearance.Pill.Small"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="80dp"
                android:minHeight="36dp"
                android:text="@string/menu_my_plan"
                android:textSize="18sp"
                android:singleLine="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/pill_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:textAlignment="center"
                android:foregroundGravity="center"
                android:foreground="@drawable/tv_focus_ripple"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:includeFontPadding="false"/>
        </LinearLayout>

            <!-- Hero Banner Carousel -->
            <LinearLayout
                android:id="@+id/bannerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:clipChildren="false"
                android:clipToPadding="false">

            <!-- Loading / Error Row (keeps spacing so it doesn't overlap with rails) -->
            <LinearLayout
                android:id="@+id/bannerStateRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/bannerLoading"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminate="true"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/bannerErrorText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/nord_on_surface"
                    android:textSize="16sp"
                    android:paddingStart="8dp"
                    android:visibility="gone"
                    android:text="@string/banner_error_generic"/>

                <TextView
                    android:id="@+id/bannerRetry"
                    style="@style/TextAppearance.Pill.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="80dp"
                    android:minHeight="36dp"
                    android:gravity="center"
                    android:text="@string/retry"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:visibility="gone"
                    android:foreground="@drawable/tv_focus_ripple"/>
            </LinearLayout>

            <!-- Horizontal carousel -->
            <HorizontalScrollView
                android:id="@+id/bannerScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:nextFocusUp="@id/topMenu">

                <LinearLayout
                    android:id="@+id/bannerRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false" />
            </HorizontalScrollView>
        </LinearLayout>

            <!-- Rails list lives in the same scroll container so banner scrolls away with it -->
            <LinearLayout
                android:id="@+id/railsContainer"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:paddingBottom="48dp"
                android:clipChildren="false"
                android:clipToPadding="false" />

        </LinearLayout>
    </ScrollView>

    <!-- Global loading indicator centered above content -->
    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#21242A"
        android:visibility="gone"
        android:focusable="false"
        android:clickable="false">

        <!-- Standard indeterminate circular progress indicator -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/circular_progress_indicator"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:indeterminate="true" />
    </FrameLayout>

</FrameLayout>
