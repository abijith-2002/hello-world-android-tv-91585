<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/headerRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Channel row -->
    <LinearLayout
        android:id="@+id/channelRow"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvChannelNumber"
            android:layout_width="56dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="@color/content_text_primary"
            android:textSize="32sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="@string/content_channel_number_default" />

        <TextView
            android:id="@+id/tvChannelName"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical"
            android:textStyle="bold"
            android:textColor="@color/content_text_primary"
            android:textSize="32sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="@string/content_channel_name_default" />
    </LinearLayout>

    <!-- Program info block -->
    <LinearLayout
        android:id="@+id/infoBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvProgramName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.ContentInfo.ProgramTitle"
            android:textStyle="normal"
            tools:text="Gladiador II" />

        <!-- Details row: Original title | duration | genres | + age -->
        <LinearLayout
            android:id="@+id/detailsRow"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvOriginalTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.ContentInfo.Meta"
                tools:text="Gladiator II" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.ContentInfo.Meta"
                android:layout_marginHorizontal="16dp"
                android:text="@string/divider_bar" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.ContentInfo.Meta"
                android:text="@string/content_duration_default" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.ContentInfo.Meta"
                android:layout_marginHorizontal="16dp"
                android:text="@string/divider_bar" />

            <TextView
                android:id="@+id/tvGenres"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.ContentInfo.Meta"
                android:text="@string/content_genres_default" />

            <!-- Age pill -->
            <TextView
                android:id="@+id/tvAge"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="22dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:gravity="center"
                style="@style/TextAppearance.ContentInfo.AgePill"
                android:text="@string/content_age_default"
                android:background="@drawable/bg_age_pill" />
        </LinearLayout>

        <!-- Timestamp row: MÁS TARDE 20:00 - 22:20 | icons -->
        <LinearLayout
            android:id="@+id/timestampRow"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvLaterTag"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:gravity="center"
                style="@style/TextAppearance.ContentInfo.Tag"
                android:text="@string/content_later_tag"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_later_tag" />

            <TextView
                android:id="@+id/tvHourStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                style="@style/TextAppearance.ContentInfo.Meta"
                android:text="@string/content_hour_start_default" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.ContentInfo.Meta"
                android:layout_marginHorizontal="8dp"
                android:text="@string/hyphen" />

            <TextView
                android:id="@+id/tvHourEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.ContentInfo.Meta"
                android:text="@string/content_hour_end_default" />

            <!-- Dividers and icon slots -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.ContentInfo.Divider32"
                android:layout_marginStart="20dp"
                android:text="@string/divider_bar"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="12dp"
                android:src="@drawable/ic_more"
                android:tint="@color/content_text_primary"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.ContentInfo.Divider32"
                android:text="@string/divider_bar"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_add"
                android:tint="@color/content_text_primary"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
