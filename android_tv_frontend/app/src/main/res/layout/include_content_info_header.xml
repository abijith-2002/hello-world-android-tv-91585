<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/headerRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Channel row -->
    <LinearLayout
        android:id="@+id/channelRow"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvChannelNumber"
            android:layout_width="56dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="@color/nord_on_surface"
            android:textSize="32sp"
            android:text="242" />

        <TextView
            android:id="@+id/tvChannelName"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical"
            android:textStyle="bold"
            android:textColor="@color/nord_on_surface"
            android:textSize="32sp"
            android:text="TNT" />
    </LinearLayout>

    <!-- Program info block -->
    <LinearLayout
        android:id="@+id/infoBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvProgramName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/nord_on_surface"
            android:textSize="60sp"
            android:textStyle="normal"
            android:text="Gladiador II" />

        <!-- Details row: Original title | duration | genres | + age -->
        <LinearLayout
            android:id="@+id/detailsRow"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvOriginalTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nord_on_surface"
                android:textSize="25sp"
                android:text="Gladiator II" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:textColor="@color/nord_on_surface"
                android:textSize="25sp"
                android:text="|" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nord_on_surface"
                android:textSize="25sp"
                android:text="2 h 28 min" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:textColor="@color/nord_on_surface"
                android:textSize="25sp"
                android:text="|" />

            <TextView
                android:id="@+id/tvGenres"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nord_on_surface"
                android:textSize="25sp"
                android:text="Acción, aventura, drama" />

            <!-- Age pill -->
            <TextView
                android:id="@+id/tvAge"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="22dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:gravity="center"
                android:textColor="@color/nord_on_surface"
                android:textSize="24sp"
                android:text="+ 16 Años"
                android:background="@drawable/card_bg" />
        </LinearLayout>

        <!-- Timestamp row: MÁS TARDE 20:00 - 22:20 | icons -->
        <LinearLayout
            android:id="@+id/timestampRow"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvLaterTag"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:gravity="center"
                android:text="@string/content_later_tag"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:background="@drawable/bg_later_tag" />

            <TextView
                android:id="@+id/tvHourStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:textColor="@color/nord_on_surface"
                android:textSize="25sp"
                android:text="20:00" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:textColor="@color/nord_on_surface"
                android:textSize="25sp"
                android:text="-" />

            <TextView
                android:id="@+id/tvHourEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nord_on_surface"
                android:textSize="25sp"
                android:text="22:20" />

            <!-- Dividers and icon slots (visual placeholders) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:textColor="@color/nord_on_surface"
                android:textSize="28sp"
                android:text="|" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="12dp"
                android:src="@drawable/ic_more"
                android:contentDescription="@string/content_icon_cd" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nord_on_surface"
                android:textSize="28sp"
                android:text="|" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_add"
                android:contentDescription="@string/content_icon_cd" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
