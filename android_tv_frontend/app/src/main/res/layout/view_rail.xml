<?xml version="1.0" encoding="utf-8"?>
<!--
  Home rail layout:
  - Displays a section title, an end-aligned inline loader chip during loading, and a horizontal row of cards.
  - No global/full-screen loader is used; each rail controls its own loading visuals (chip + skeleton cards).
  - Keep views non-focusable where appropriate so DPAD navigation stays on cards and top menu.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/railRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="20dp"
    android:layout_marginBottom="8dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="@dimen/rail_title_top_padding">

    <!-- Title row with optional small loading chip on the right -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/rail_horizontal_padding"
        android:paddingEnd="@dimen/rail_horizontal_padding"
        android:paddingBottom="@dimen/rail_title_bottom_padding">

        <TextView
            android:id="@+id/railTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/nord_on_surface"
            android:textStyle="bold"
            android:textSize="20sp"
            android:fontFamily="@font/reddit_sans_regular"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_toStartOf="@id/railHeaderEnd"/>

        <!-- End container for loader UI to prevent overlap with title -->
        <LinearLayout
            android:id="@+id/railHeaderEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:minWidth="64dp"
            android:orientation="horizontal"
            android:focusable="false"
            android:focusableInTouchMode="false">

            <!-- Small inline loader chip; visible while this rail is loading (per-section loader) -->
            <LinearLayout
                android:id="@+id/railLoadingChip"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/pill_button_background"
                android:visibility="gone"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="false"
                android:longClickable="false"
                android:accessibilityLiveRegion="polite"
                android:importantForAccessibility="yes"
                android:contentDescription="@string/loading_section">

                <ProgressBar
                    android:id="@+id/railTinyProgress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:minWidth="18dp"
                    android:minHeight="18dp"
                    android:indeterminate="true"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/app_name"
                    android:indeterminateTint="@color/loader_blue_color"/>

                <TextView
                    android:id="@+id/railLoadingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/loading"
                    style="@style/TextAppearance.Rail.LoaderChip"
                    android:textAllCaps="false"
                    android:letterSpacing="0.02"/>
            </LinearLayout>

            <!-- Fallback tiny loader (platform ProgressBar) in case Material component is not available -->
            <ProgressBar
                android:id="@+id/railTinyProgressFallback"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:indeterminate="true"
                android:visibility="gone"
                android:contentDescription="@string/app_name"
                android:indeterminateTint="@color/nord_on_surface" />

            <!-- Optional empty-state hint; controlled in code when needed -->
            <TextView
                android:id="@+id/railEmptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="4dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:alpha="0.75"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:importantForAccessibility="yes"
                android:text="@string/empty_state_no_items"
                android:textColor="@color/nord_on_surface"
                android:textSize="14sp"
                android:fontFamily="@font/reddit_sans_regular"
                android:visibility="gone"/>
        </LinearLayout>
    </RelativeLayout>

    <HorizontalScrollView
        android:id="@+id/railScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fadingEdgeLength="12dp"
        android:requiresFadingEdge="horizontal"
        android:paddingStart="@dimen/rail_horizontal_padding"
        android:paddingEnd="@dimen/rail_horizontal_padding"
        android:nextFocusUp="@id/topMenu">

        <LinearLayout
            android:id="@+id/railRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/rail_item_min_height"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:paddingEnd="8dp" />
    </HorizontalScrollView>

</LinearLayout>
