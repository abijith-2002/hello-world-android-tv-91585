<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/railRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="20dp"
    android:layout_marginBottom="8dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="4dp">

    <TextView
        android:id="@+id/railTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/nord_on_surface"
        android:textStyle="bold"
        android:textSize="20sp"
        android:paddingStart="8dp"
        android:paddingBottom="8dp" />

    <!-- Section-scoped loader shown while this rail's data is loading -->
    <LinearLayout
        android:id="@+id/railLoader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:importantForAccessibility="no"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/railProgress"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:indeterminate="true"
            android:progressTint="@color/loader_blue"
            android:backgroundTint="@color/nord_surface" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/railScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:nextFocusUp="@id/topMenu">

        <LinearLayout
            android:id="@+id/railRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false" />
    </HorizontalScrollView>

</LinearLayout>
