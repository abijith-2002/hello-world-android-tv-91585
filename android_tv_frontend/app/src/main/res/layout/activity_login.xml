<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <TextView
        android:id="@+id/loginTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_login"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/inputUsername"
        android:layout_width="240dp"
        android:layout_height="48dp"
        android:hint="@string/hint_username_email"
        android:inputType="textEmailAddress"
        android:textColor="@color/nord_on_surface"
        android:textColorHint="@color/nord_grey_300"
        android:background="@drawable/pill_button_background"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/errorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/loader_blue"
        android:textSize="14sp"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnBack"
            style="@style/TextAppearance.Pill.Small"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="80dp"
            android:gravity="center"
            android:text="@string/menu_home"
            android:textColor="@color/white"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:foreground="@drawable/tv_focus_ripple"
            android:background="@drawable/pill_button_background"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnSubmit"
            style="@style/TextAppearance.Pill.Small"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="80dp"
            android:gravity="center"
            android:text="@string/action_sign_in"
            android:textColor="@color/white"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:foreground="@drawable/tv_focus_ripple"
            android:background="@drawable/pill_button_background" />
    </LinearLayout>
</LinearLayout>
