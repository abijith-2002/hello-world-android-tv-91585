<?xml version="1.0" encoding="utf-8"?>
<!--
    Content Info Detail Screen Layout
    MATCHeS Figma screen pixel-for-pixel in: copy (esp. casing), spacing, font size/weight, lineheight and alignment.
    See: 20251022_063948_35.png; use only system sans (Android TV), no Reddit/Nord font.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:ignore="MissingConstraints">

    <!-- Background image and left-to-right gradient overlay -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/content_info_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:ignore="ContentDescription"
        tools:src="@drawable/thumb_1" />

    <View
        android:id="@+id/gradientOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/gradient_content_overlay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:ignore="ContentDescription" />

    <!-- Metadata & content panel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/metadataPanel"
        android:layout_width="1150dp"
        android:layout_height="590dp"
        android:layout_marginStart="96dp"
        android:layout_marginTop="108dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Channel number and name -->
        <TextView
            android:id="@+id/channelNumber"
            android:layout_width="56dp"
            android:layout_height="38dp"
            android:text="242"
            android:textColor="#E3E3E3"
            android:textSize="32sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:letterSpacing="0"
            android:layout_marginTop="0dp"
            android:gravity="bottom"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/channelName"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="TNT"
            android:textColor="#E3E3E3"
            android:textSize="32sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            app:layout_constraintStart_toEndOf="@id/channelNumber"
            app:layout_constraintTop_toTopOf="@id/channelNumber"
            android:layout_marginStart="12dp"
            tools:ignore="HardcodedText"
        />

        <!-- Program (Title) -->
        <TextView
            android:id="@+id/contentTitle"
            android:layout_width="1150dp"
            android:layout_height="70dp"
            android:layout_marginTop="67dp"
            android:text="Gladiador II"
            android:textColor="#FFFFFF"
            android:textSize="60sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:letterSpacing="0"
            android:gravity="bottom"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText"
            android:maxLines="1"
            android:ellipsize="end"
        />

        <!-- Meta row: subtitle | duration | genres | age tag -->
        <LinearLayout
            android:id="@+id/metadataRow"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="143dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="Gladiator II"
                android:textColor="#E3E3E3"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="normal"
                android:gravity="center_vertical"
                android:letterSpacing="0"
                tools:ignore="HardcodedText"
            />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="|"
                android:textColor="#E3E3E3"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="normal"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/duration"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="2 h 28 min"
                android:textColor="#E3E3E3"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="normal"
                android:letterSpacing="0"
                android:gravity="center_vertical"
                tools:ignore="HardcodedText"
            />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="|"
                android:textColor="#E3E3E3"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="normal"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/genres"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="Acción, aventura, drama"
                android:textColor="#E3E3E3"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="normal"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="|"
                android:textColor="#E3E3E3"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="normal"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/ageRating"
                android:layout_width="124dp"
                android:layout_height="32dp"
                android:text="+ 16 Años"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:gravity="center"
                android:letterSpacing="0.5"
                android:background="@drawable/tag_age_bg"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:includeFontPadding="false"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- Time row: time tag | slot | | | action/replay icons (dummy for TV, handled in code) -->
        <LinearLayout
            android:id="@+id/timeInfoRow"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="32dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/metadataRow">

            <TextView
                android:id="@+id/timeLabel"
                android:layout_width="156dp"
                android:layout_height="32dp"
                android:text="MÁS TARDE"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:background="@drawable/tag_time_bg"
                android:gravity="center"
                android:letterSpacing="1.2"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:includeFontPadding="false"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/timeSlot"
                android:layout_width="143dp"
                android:layout_height="32dp"
                android:text="20:00 - 22:20"
                android:textColor="#E3E3E3"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="normal"
                android:gravity="center"
                android:layout_marginStart="22dp"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/description"
            android:layout_width="925dp"
            android:layout_height="117dp"
            android:layout_marginTop="94dp"
            android:text="Lucio es obligado a entrar en el Coliseo después de que su hogar sea conquistado por los tiránicos emperadores que ahora dirigen Roma con puño de hierro. Con la ira en su corazón y el futuro del Imperio en juego, Lucio debe mirar hacia atrás para encontrar fuerza y devolver la gloria de Roma a su pueblo."
            android:textColor="#E3E3E3"
            android:textSize="22sp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.2"
            android:lineSpacingExtra="17sp"
            android:maxLines="3"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/timeInfoRow"
            tools:ignore="HardcodedText" />

        <!-- Actions row: 6 horizontal buttons, precisely sized -->
        <LinearLayout
            android:id="@+id/actionButtonsRow"
            android:layout_width="916dp"
            android:layout_height="156dp"
            android:layout_marginTop="41dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/description">

            <include layout="@layout/view_action_button" android:id="@+id/actionButton1" />
            <Space android:layout_width="16dp" android:layout_height="1dp" />
            <include layout="@layout/view_action_button" android:id="@+id/actionButton2" />
            <Space android:layout_width="16dp" android:layout_height="1dp" />
            <include layout="@layout/view_action_button" android:id="@+id/actionButton3" />
            <Space android:layout_width="16dp" android:layout_height="1dp" />
            <include layout="@layout/view_action_button" android:id="@+id/actionButton4" />
            <Space android:layout_width="16dp" android:layout_height="1dp" />
            <include layout="@layout/view_action_button" android:id="@+id/actionButton5" />
            <Space android:layout_width="16dp" android:layout_height="1dp" />
            <include layout="@layout/view_action_button" android:id="@+id/actionButton6" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- System Date/Time: top-right -->
    <LinearLayout
        android:id="@+id/systemDateTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="55dp"
        android:layout_marginEnd="96dp"
        android:orientation="vertical"
        android:gravity="end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/systemTime"
            android:layout_width="100dp"
            android:layout_height="48dp"
            android:text="20:44"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:gravity="right"
            android:lineSpacingExtra="8sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/systemDate"
            android:layout_width="81dp"
            android:layout_height="32dp"
            android:layout_marginTop="10dp"
            android:text="7 abr."
            android:textColor="#E3E3E3"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:gravity="right"
            android:lineSpacingExtra="12sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
