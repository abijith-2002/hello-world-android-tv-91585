<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contentInfoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:adjustViewBounds="false"
        android:contentDescription="@string/content_background_description"
        android:cropToPadding="false"
        android:padding="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_content_info_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Gradient Overlay -->
    <View
        android:id="@+id/gradientOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/gradient_horizontal_overlay"
        app:layout_constraintBottom_toBottomOf="@id/backgroundImage"
        app:layout_constraintEnd_toEndOf="@id/backgroundImage"
        app:layout_constraintStart_toStartOf="@id/backgroundImage"
        app:layout_constraintTop_toTopOf="@id/backgroundImage" />

    <!-- Metadata scale container pinned near top-left -->
    <FrameLayout
        android:id="@+id/metadataPanelScaleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="96dp"
        android:layout_marginTop="80dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/metadataPanel"
            android:layout_width="1150dp"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:pivotX="575"
            android:pivotY="0"
            android:scaleX="0.7"
            android:scaleY="0.7">

            <!-- Channel Information Row -->
            <LinearLayout
                android:id="@+id/channelInfoRow"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/channelNumber"
                    android:layout_width="56dp"
                    android:layout_height="40dp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="end|center_vertical"
                    android:includeFontPadding="false"
                    android:lineHeight="38sp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="242"
                    android:textColor="#FFFFFF"
                    android:textAlignment="viewEnd"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/channelName"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:lineHeight="38sp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="TNT"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp" />
            </LinearLayout>

            <!-- Program Title -->
            <TextView
                android:id="@+id/programTitle"
                android:layout_width="1150dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:lineHeight="70sp"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Gladiador II"
                android:textColor="#FFFFFF"
                android:textSize="60sp" />

            <!-- Metadata Row -->
            <LinearLayout
                android:id="@+id/metadataRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/metadataOriginal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:lineHeight="29sp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Gladiator II"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="sans-serif"
                    android:text="|"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/metadataDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:lineHeight="29sp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="2 h 28 min"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="sans-serif"
                    android:text="|"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/metadataGenres"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:lineHeight="29sp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Acción, aventura, drama"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="sans-serif"
                    android:text="|"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/ageRating"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/tag_age_rating"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:text="+ 16 Años"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Time and Status Row -->
            <LinearLayout
                android:id="@+id/timeStatusRow"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="10dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/statusTag"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/tag_status"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lineHeight="32sp"
                    android:maxLines="1"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:singleLine="true"
                    android:text="MÁS TARDE"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/timeStart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:lineHeight="29sp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="20:00"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="-"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/timeEnd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:lineHeight="29sp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="22:20"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:fontFamily="sans-serif"
                    android:text="|"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:fontFamily="sans-serif"
                    android:text="|"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp" />

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="29dp"
                    android:contentDescription="@string/icon_audio_subtitle_desc"
                    android:src="@drawable/ic_audio_subtitle" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Description separate so we can constrain above action buttons -->
    <TextView
        android:id="@+id/description"
        android:layout_width="925dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="96dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:lineHeight="39sp"
        android:maxLines="3"
        android:singleLine="false"
        android:text="Lucio es obligado a entrar en el Coliseo después de que su hogar sea conquistado por los tiránicos emperadores que ahora dirigen Roma con puño de hierro. Con la ira en su corazón y el futuro del Imperio en juego, Lucio debe mirar hacia atrás para encontrar fuerza y devolver la gloria de Roma a su pueblo."
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/metadataPanelScaleContainer" />

    <!-- Action Buttons fixed at bottom; keep IDs the same -->
    <LinearLayout
        android:id="@+id/actionButtonsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="96dp"
        android:layout_marginBottom="48dp"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include
            android:id="@+id/btnPlay"
            layout="@layout/view_action_button"
            android:layout_width="104dp"
            android:layout_height="80dp" />

        <include
            android:id="@+id/btnSchedule"
            layout="@layout/view_action_button"
            android:layout_width="104dp"
            android:layout_height="80dp"
            android:layout_marginStart="@dimen/content_actions_button_spacing" />

        <include
            android:id="@+id/btnRecord"
            layout="@layout/view_action_button"
            android:layout_width="104dp"
            android:layout_height="80dp"
            android:layout_marginStart="@dimen/content_actions_button_spacing" />

        <include
            android:id="@+id/btnFavorite"
            layout="@layout/view_action_button"
            android:layout_width="104dp"
            android:layout_height="80dp"
            android:layout_marginStart="@dimen/content_actions_button_spacing" />

        <include
            android:id="@+id/btnBlock"
            layout="@layout/view_action_button"
            android:layout_width="104dp"
            android:layout_height="80dp"
            android:layout_marginStart="@dimen/content_actions_button_spacing" />

        <include
            android:id="@+id/btnAudioSubtitles"
            layout="@layout/view_action_button"
            android:layout_width="104dp"
            android:layout_height="80dp"
            android:layout_marginStart="@dimen/content_actions_button_spacing" />
    </LinearLayout>

    <!-- System Date/Time top-right -->
    <LinearLayout
        android:id="@+id/systemDateTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="96dp"
        android:layout_marginTop="48dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/systemTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="start"
            android:includeFontPadding="false"
            android:lineHeight="48sp"
            android:maxLines="1"
            android:minWidth="120dp"
            android:singleLine="true"
            android:text="20:44"
            android:textColor="#FFFFFF"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/systemDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="end"
            android:includeFontPadding="false"
            android:lineHeight="32sp"
            android:maxLines="1"
            android:singleLine="true"
            android:text="7 abr"
            android:textColor="#FFFFFF"
            android:textSize="28sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
