<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/thumbCard"
    style="@style/Widget.Card.Nord"
    android:layout_width="180dp"
    android:layout_height="270dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:foreground="@drawable/tv_focus_ripple"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:nextFocusUp="@id/topMenu"
    android:clipToOutline="true"
    android:outlineProvider="background"
    app:cardUseCompatPadding="false"
    app:cardBackgroundColor="@color/nord_surface"
    app:strokeColor="@color/nord_unfocused_stroke"
    app:strokeWidth="1dp"
    app:shapeAppearance="@style/ShapeAppearance.Medium.Rounded"
    app:contentPadding="0dp">

    <!-- Full-bleed poster image; CENTER_CROP to fill, clipped to card's rounded outline -->
    <ImageView
        android:id="@+id/thumbImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/thumb_image_cd"
        android:scaleType="centerCrop"
        android:adjustViewBounds="false"
        android:cropToPadding="false" />

    <!-- Bottom overlay gradient and title for readability -->
    <View
        android:id="@+id/overlayGrad"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_horizontal_overlay"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/thumbTitle"
        style="@style/TextAppearance.Card.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:text=""
        android:visibility="gone"/>
</com.google.android.material.card.MaterialCardView>
