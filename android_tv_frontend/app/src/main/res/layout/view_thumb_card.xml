<?xml version="1.0" encoding="utf-8"?>
<!--
  Simple thumbnail card used in rails.
  IDs must match HomeActivity expectations: thumbImage, thumbTitle, overlayGrad.
  Uses minimalist styling compatible with Nord dark theme via parent background and existing styles.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/thumbCardRoot"
    android:layout_width="200dp"
    android:layout_height="300dp"
    android:foreground="?attr/selectableItemBackgroundBorderless"
    android:background="@drawable/card_bg"
    android:clipToPadding="false"
    android:focusable="true"
    android:clickable="true"
    android:padding="0dp">

    <ImageView
        android:id="@+id/thumbImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:id="@+id/overlayGrad"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_horizontal_overlay"
        android:visibility="gone" />

    <TextView
        android:id="@+id/thumbTitle"
        style="@style/TextAppearance.AppCompat.Body1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:padding="8dp"
        android:text=""
        android:textColor="@android:color/white"
        android:visibility="gone" />
</FrameLayout>
