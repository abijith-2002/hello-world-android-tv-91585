<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detailsRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:orientation="vertical">

    <!-- Description (925xwrap) -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="@dimen/contentinfo_description_width"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textColor="@color/content_text_primary"
        android:textSize="26sp"
        android:lineSpacingExtra="13dp"
        android:lineHeight="39sp"
        android:includeFontPadding="false"
        android:maxLines="3"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:text="@string/content_description_fallback" />

    <!-- Buttons row: 3 main buttons (Play, Add, More) with 142x156 panels -->
    <LinearLayout
        android:id="@+id/buttonsRow"
        android:layout_width="wrap_content"
        android:layout_height="156dp"
        android:orientation="horizontal">

        <!-- Play -->
        <LinearLayout
            android:id="@+id/btnPlay"
            android:layout_width="@dimen/contentinfo_button_panel_width"
            android:layout_height="@dimen/contentinfo_button_panel_height"
            android:foreground="@drawable/tv_focus_ripple_content_info"
            android:focusable="true"
            android:nextFocusRight="@id/btnAdd"
            android:contentDescription="@string/content_action_play"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="@dimen/contentinfo_icon_container_width"
                android:layout_height="@dimen/contentinfo_icon_container_height"
                android:layout_marginStart="19dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_round_light">

                <ImageView
                    android:layout_width="@dimen/contentinfo_action_icon_size"
                    android:layout_height="@dimen/contentinfo_action_icon_size"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play"
                    android:tint="@color/content_text_primary"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:layout_width="@dimen/contentinfo_action_label_width"
                android:layout_height="@dimen/contentinfo_action_label_height"
                android:layout_marginTop="16dp"
                android:layout_marginStart="2dp"
                android:gravity="center"
                style="@style/TextAppearance.ContentInfo.ButtonLabel"
                android:text="@string/content_action_play" />
        </LinearLayout>

        <!-- Add -->
        <LinearLayout
            android:id="@+id/btnAdd"
            android:layout_width="@dimen/contentinfo_button_panel_width"
            android:layout_height="@dimen/contentinfo_button_panel_height"
            android:layout_marginStart="2dp"
            android:foreground="@drawable/tv_focus_ripple_content_info"
            android:focusable="true"
            android:nextFocusLeft="@id/btnPlay"
            android:nextFocusRight="@id/btnMore"
            android:contentDescription="@string/content_action_add"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="104dp"
                android:layout_height="80dp"
                android:layout_marginStart="19dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_round_light">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_add"
                    android:tint="@color/content_text_primary"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:layout_width="138dp"
                android:layout_height="28dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="2dp"
                android:gravity="center"
                style="@style/TextAppearance.ContentInfo.ButtonLabel"
                android:text="@string/content_action_add" />
        </LinearLayout>

        <!-- More -->
        <LinearLayout
            android:id="@+id/btnMore"
            android:layout_width="@dimen/contentinfo_button_panel_width"
            android:layout_height="@dimen/contentinfo_button_panel_height"
            android:layout_marginStart="2dp"
            android:foreground="@drawable/tv_focus_ripple_content_info"
            android:focusable="true"
            android:nextFocusLeft="@id/btnAdd"
            android:contentDescription="@string/content_action_more"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="104dp"
                android:layout_height="80dp"
                android:layout_marginStart="19dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_round_light">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_more"
                    android:tint="@color/content_text_primary"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:layout_width="138dp"
                android:layout_height="28dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="2dp"
                android:gravity="center"
                style="@style/TextAppearance.ContentInfo.ButtonLabel"
                android:text="@string/content_action_more" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
