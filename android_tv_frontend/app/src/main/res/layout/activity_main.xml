<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nord_bg">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/helloCard"
        style="@style/Widget.Card.Nord"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/card_bg"
        android:foreground="@drawable/tv_focus_ripple"
        android:alpha="1.0"
        android:visibility="visible"
        app:cardUseCompatPadding="true"
        app:cardElevation="8dp"
        app:contentPadding="8dp"
        app:layout_constraintWidth_min="320dp"
        app:layout_constraintWidth_max="720dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Temporary debug container to verify visibility. Remove after fix is validated. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardContentDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:background="#40FF0000"
            android:alpha="1.0"
            android:visibility="visible">
            <!-- semi-transparent red for debug -->

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="32dp"
                android:text="@string/hello_world"
                android:textSize="28sp"
                android:gravity="center"
                android:textColor="?attr/colorOnSurface"
                android:alpha="1.0"
                android:visibility="visible"
                android:contentDescription="@string/hello_world"
                style="@style/TextAppearance.Card.Title"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
