<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nord_bg">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/helloCard"
        style="@style/Widget.Card.Nord"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/card_bg"
        android:foreground="@drawable/tv_focus_ripple"
        app:cardUseCompatPadding="true"
        app:cardElevation="8dp"
        app:layout_constraintWidth_min="320dp"
        app:layout_constraintWidth_max="720dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="32dp"
            android:text="@string/hello_world"
            android:textColor="@color/nord_text"
            android:textSize="28sp"
            android:fontFamily="@font/reddit_sans_regular"
            android:gravity="center" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
