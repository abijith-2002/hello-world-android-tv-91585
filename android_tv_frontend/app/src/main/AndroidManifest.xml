<?xml version="1.0" encoding="utf-8"?>
<manifest package="com.example.tv" xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".TVApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">
        <meta-data
            android:name="android.support.TV_LEANBACK_LAUNCHER"
            android:resource="@xml/tv_leanback_launcher" />

        <activity android:name=".ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity" android:exported="false"/>
        <activity android:name=".ui.login.LoginActivity" android:exported="false"/>
        <activity android:name=".ui.home.HomeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".ui.content.ContentInfoActivity" android:exported="false"/>
    </application>
</manifest>
