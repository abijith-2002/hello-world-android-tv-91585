<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name="com.example.tv.TVApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.TV.NordDark"
        android:supportsRtl="true"
        android:banner="@drawable/banner_tv">

        <!-- Launcher: SplashActivity -->
        <activity
            android:name="com.example.tv.ui.SplashActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:banner="@drawable/banner_tv"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home screen -->
        <activity
            android:name="com.example.tv.ui.home.HomeActivity"
            android:exported="false"
            android:banner="@drawable/banner_tv"
            android:icon="@mipmap/ic_launcher" />

        <!-- Login -->
        <activity
            android:name="com.example.tv.ui.login.LoginActivity"
            android:exported="true"
            android:launchMode="singleTop" />

        <!-- Existing Hello World page -->
        <activity
            android:name="com.example.tv.MainActivity"
            android:banner="@drawable/banner_tv"
            android:icon="@mipmap/ic_launcher"
            android:exported="false" />

        <!-- Content Info Detail Screen -->
        <activity
            android:name="com.example.tv.ui.contentinfo.ContentInfoActivity"
            android:theme="@style/Theme.ContentInfo"
            android:exported="false"
            android:banner="@drawable/banner_tv"
            android:icon="@mipmap/ic_launcher" />

    </application>
</manifest>
