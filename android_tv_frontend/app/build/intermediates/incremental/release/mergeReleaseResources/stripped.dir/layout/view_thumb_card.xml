<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/thumbCard"
    android:layout_width="180dp"
    android:layout_height="270dp"
    android:foreground="@drawable/tv_focus_ripple"
    android:background="@drawable/card_bg"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="true"
    android:clipToPadding="true">

    <!-- Center-cropped poster image fills the fixed portrait card -->
    <ImageView
        android:id="@+id/thumbImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/thumb_image_cd"
        android:scaleType="centerCrop"
        android:adjustViewBounds="false" />

    <!-- Bottom overlay gradient and title for readability -->
    <View
        android:id="@+id/overlayGrad"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_horizontal_overlay"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/thumbTitle"
        style="@style/TextAppearance.Card.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:text=""
        android:visibility="gone"/>
</FrameLayout>
