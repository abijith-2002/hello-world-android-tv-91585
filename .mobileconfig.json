{
  "project": {
    "name": "hello-world-android-tv",
    "type": "android",
    "language": "kotlin",
    "rootDir": "android_tv_frontend",
    "wrapper": "android_tv_frontend/gradlew"
  },
  "modules": [
    { "name": ":app", "path": "android_tv_frontend/app", "kind": "application" },
    { "name": ":list", "path": "android_tv_frontend/list", "kind": "library" },
    { "name": ":utilities", "path": "android_tv_frontend/utilities", "kind": "library" }
  ],
  "artifacts": {
    "debugApk": "android_tv_frontend/app/build/outputs/apk/debug/app-debug.apk"
  },
  "build": {
    "defaultTask": "assembleDebug",
    "commands": [
      "cd android_tv_frontend && ./gradlew assembleDebug",
      "./gradlew -p android_tv_frontend :app:assembleDebug"
    ]
  }
}
